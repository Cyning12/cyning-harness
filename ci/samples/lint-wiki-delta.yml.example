# Optional · wiki_delta 缺字段扫描（升级后迁移清单 · v2.19+）
#
# 用途：复制为 .github/workflows/lint-wiki-delta.yml（或并入既有 workflow 的一步）。
# 命令：npx @cyning/harness task lint-wiki-delta
# 失败策略：样例默认硬失败（exit 2 = 有缺字段）。迁移中仓可临时 continue-on-error: true。
#
# 配套 runbook：docs/RUNBOOK_upgrade_wiki_delta_v1_zh.md
# 决策树：docs/USER_GUIDE_v1.0_zh.md §6.0b

name: lint-wiki-delta

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  lint-wiki-delta:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      # npx-only：关闭 setup-node@v5 默认 packageManager 缓存
      # （package.json 若声明 packageManager=pnpm 且未装 pnpm → Unable to locate executable file: pnpm）
      - name: Setup Node
        uses: actions/setup-node@v5
        with:
          node-version: "24"
          package-manager-cache: false

      - name: task lint-wiki-delta
        # 迁移中可改为 continue-on-error: true；迁完后应硬失败
        run: npx --yes @cyning/harness@2.19 task lint-wiki-delta --target .

      # 可选：仅扫 active（关账前）
      # - name: lint-wiki-delta · active only
      #   run: npx --yes @cyning/harness@2.19 task lint-wiki-delta --target . --scope active
